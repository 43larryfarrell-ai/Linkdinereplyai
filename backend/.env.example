# LinkedIn Reply AI Backend - Environment Variables for Render Deployment
# Fill in your actual API keys below

# Gemini API Keys (comma-separated for rotation)
# If one key hits rate limit, the system will automatically rotate to the next one
# Example: GEMINI_API_KEYS=key1,key2,key3
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2,your_gemini_api_key_3

# Flutterwave Payment Gateway (Required for card/mobile money payments)
# Get keys from: https://dashboard.flutterwave.com/
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-YOUR_PUBLIC_KEY_HERE
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-YOUR_SECRET_KEY_HERE
FLUTTERWAVE_WEBHOOK_HASH=your_webhook_hash_here

# Server Configuration (Render uses PORT automatically, but set for local dev)
PORT=10000
NODE_ENV=production

# CORS Configuration
ALLOWED_ORIGINS=*

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API Key Rotation Configuration
# Cooldown period (in milliseconds) for rate-limited keys before retrying
# Default: 1 hour (3600000 ms)
API_KEY_COOLDOWN_MS=3600000

# Notes:
# 1. For development, use TEST Flutterwave keys
# 2. For production, remove "TEST" from Flutterwave keys
# 3. Webhook hash is in Flutterwave dashboard → Settings → Webhooks
# 4. Update ALLOWED_ORIGINS with your production domain for security